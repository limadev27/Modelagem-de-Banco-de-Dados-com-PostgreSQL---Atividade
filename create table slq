-- 1. CRIA A TABELA SERVIDOR 
CREATE TABLE IF NOT EXISTS PUBLIC.SERVIDOR (ID INT PRIMARY KEY, NOME VARCHAR(50), META INT);

-- 2. CRIANDO A TABELA DE SEXO
CREATE TABLE IF NOT EXISTS PUBLIC.SEXO (ID INT PRIMARY KEY, SEXO VARCHAR(10));

-- 3. CRIANDO A TABELA PESSOA JÁ VERIFICANDO SE É MAIOR OU IGUAL A 16 ANOS DE IDADE
CREATE TABLE IF NOT EXISTS PUBLIC PUBLIC.PESSOA (ID INT PRIMARY KEY, ID_SEXO INT REFERENCES PUBLIC.SEXO, NOME VARCHAR(100), CPF VARCHAR(11), TELEFONE VARCHAR(11), EMAIL VARCHAR(100), DATA_NASCIMENTO DATE NOT NULL, ID_SERVIDOR INT REFERENCES PUBLI.)

